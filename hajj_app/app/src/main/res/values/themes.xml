<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.HajjApp" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorCanvas">#FFF8F4</item><item name="colorSurfaceAlt">#FFF1E4</item>
        <item name="colorOnSurfaceVariant">#514536</item><item name="colorOutline">#D6C4B1</item>
        <item name="colorNavigationSurface">#FFF1E4</item><item name="colorNavigationActive">#FEE2B7</item><item name="colorNavigationUnselected">#74685C</item>
        <!-- Primary brand color -->
        <item name="colorPrimary">#0D4736</item>
        <item name="colorPrimaryVariant">#002F22</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">#FDB963</item>
        <item name="colorSecondaryVariant">#855300</item>
        <item name="colorOnSecondary">#000000</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">#002F22</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">#FFF8F4</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#231A0D</item>
        <item name="android:navigationBarColor">#FFF8F4</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Card styles -->
        <item name="materialCardViewStyle">@style/Widget.HajjApp.CardView</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.HajjApp.Navigation.ActiveIndicator</item>
        
        <!-- Text appearance -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.HajjApp.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.HajjApp.Headline2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.HajjApp.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.HajjApp.Body2</item>
        
        <!-- Enable window content transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
    </style>

    <style name="Theme.HajjApp.SacredRawdah" parent="Theme.HajjApp">
