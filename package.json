{
  "name": "hajj-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "scripts": {
    "android": "node scripts/run-gradle.js :app:installDebug",
    "lint": "eslint App.tsx src --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check App.tsx src",
    "start": "react-native start",
    "test": "jest",
    "test:islamic-content": "jest src/__tests__/IslamicContentValidation.test.ts --runInBand",
    "test:unit": "jest src/__tests__ --runInBand",
    "build:android:debug": "node scripts/run-gradle.js :app:assembleDebug",
    "build:android": "node scripts/run-gradle.js :app:assembleRelease",
    "build:android:bundle": "node scripts/run-gradle.js :app:bundleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/stack": "^6.3.0",
    "crypto-js": "^4.2.0",
    "react": "18.2.0",
    "react-native": "^0.72.17",
    "react-native-elements": "^3.4.3",
    "react-native-gesture-handler": "^2.13.0",
    "react-native-linear-gradient": "^2.8.0",
    "react-native-maps": "1.8.0",
    "react-native-paper": "^5.10.0",
    "react-native-safe-area-context": "^4.7.0",
    "react-native-screens": "^3.25.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-vector-icons": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.0",
    "@react-native/metro-config": "^0.72.0",
    "@testing-library/react-native": "^12.9.0",
    "@tsconfig/react-native": "^3.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^29.2.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.0",
    "prettier": "^3.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  },
  "workspaces": [
    "hajj_app",
    "hajj_app_flutter"
  ]
}
